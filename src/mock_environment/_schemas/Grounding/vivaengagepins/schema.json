{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VivaEngagePins",
  "description": "Manufactured VivaEngagePins schema",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "$ref": "#/$defs/VivaEngagePin"
  },
  "$defs": {
    "VivaEngagePin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ConversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ActionType": {
          "type": "string",
          "enum": [
            "pin",
            "feature"
          ]
        }
      },
      "required": [
        "ConversationId",
        "ActionType"
      ]
    }
  }
}