    {
      "ruleId": "ef37334e-5a2a-4654-bf03-d949508f49ce",
      "name": "Property annotation isQueryable, isRetrievable, isSearchable should be true on specific labels",
      "description": "",
      "severity": "Warning",
      "scope": "SingleFile",
      "logic": {
        "conditionalAssertion": {
          "if": {
            "or": [
              {
                "field": "labels",
                "operator": "contains",
                "valueType": "array",
                "value": "assignedToPeople"
              },
              {
                "field": "labels",
                "operator": "contains",
                "valueType": "array",
                "value": "secondaryId"
              }
            ]
          },
          "then": {
            "and": [
              {
                "field": "isQueryable",
                "operator": "==",
                "valueType": "boolean",
                "value": "true"
              },
              {
                "field": "isRetrievable",
                "operator": "==",
                "valueType": "boolean",
                "value": "true"
              },
              {
                "field": "isSearchable",
                "operator": "==",
                "valueType": "boolean",
                "value": "true"
              }
            ]
          },
          "arrayScope": "Properties"
        }
      },
      "metadata": {
        "field": "",
        "expression": "For each 'Properties' element: IF ('labels' contains assignedToPeople) OR ('labels' contains secondaryId) THEN ('isQueryable' == true) AND ('isRetrievable' == true) AND ('isSearchable' == true)"
      },
      "category": "ConditionalAssertion",
      "isEnabled": true
    }
  ],
  "jsonLogicVersion": "2.0"
