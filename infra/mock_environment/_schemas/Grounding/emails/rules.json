    {
      "ruleId": "28f41f8c-caa4-4ed3-9978-255cc3ff2ca3",
      "name": "Embedded images emails' BodyType should be HTML",
      "description": "Embedded images emails' BodyType should be HTML",
      "severity": "Error",
      "scope": "SingleFile",
      "logic": {
        "customValidator": {
          "validatorId": "email-embedded-image-body-type-validator-v1"
        }
      },
      "metadata": {
        "field": "",
        "expression": "Execute custom validator 'email-embedded-image-body-type-validator-v1'"
      },
      "category": "CustomValidator",
      "isEnabled": true
