{
  "typeName": "events",
  "rules": [
    {
      "ruleId": "ada3ee94-ecb8-4fb7-bfb1-94ce368d1083",
      "name": "Unique Virtual Event IDs",
      "description": "Each event must have a unique virtual EventId within the file \"events.config.json\"",
      "severity": "Error",
      "scope": "SingleFile",
      "logic": {
        "unique": {
          "var": "EventId",
          "caseSensitive": true
        }
      },
      "metadata": {
        "field": "EventId",
        "expression": "All values of 'EventId' must be unique"
      },
      "category": "Uniqueness",
      "isEnabled": true
    },
    {
      "ruleId": "e5f04a6e-ac2e-4f7c-a729-336515801718",
      "name": "StartDateTime Before EndDateTime",
      "description": "Event StartDateTime must be before or equal to EndDateTime",
      "severity": "Error",
      "scope": "SingleFile",
      "logic": {
        "conditionalAssertion": {
          "if": {
            "and": [
              {
                "field": "StartDateTime",
                "operator": "is_not_null",
                "valueType": "string"
              },
              {
                "field": "EndDateTime",
                "operator": "is_not_null",
                "valueType": "string"
              }
            ]
          },
          "then": {
            "field": "EndDateTime",
            "operator": ">=",
            "valueType": "datetime",
            "compareField": "StartDateTime"
          }
        }
      },
      "metadata": {
        "field": "",
        "expression": "IF ('StartDateTime' is_not_null) AND ('EndDateTime' is_not_null) THEN 'EndDateTime' >= 'StartDateTime'"
      },
      "category": "ConditionalAssertion",
      "isEnabled": true
    },
    {
      "ruleId": "53b44644-5fa9-403e-bac9-87990ccf7117",
      "name": "Recurrence Range Start Before End",
      "description": "When recurrence range type is 'endDate', StartDate must be before or equal to EndDate",
      "severity": "Error",
      "scope": "SingleFile",
      "logic": {
        "conditionalAssertion": {
          "if": {
            "and": [
              {
                "field": "Recurrence.RecurrenceRange.StartDate",
                "operator": "is_not_null",
                "valueType": "string"
              },
              {
                "field": "Recurrence.RecurrenceRange.EndDate",
                "operator": "is_not_null",
                "valueType": "string"
              }
            ]
          },
          "then": {
            "field": "Recurrence.RecurrenceRange.EndDate",
            "operator": ">=",
            "valueType": "datetime",
            "compareField": "Recurrence.RecurrenceRange.StartDate"
          }
        }
      },
      "metadata": {
        "field": "",
        "expression": "IF ('Recurrence.RecurrenceRange.StartDate' is_not_null) AND ('Recurrence.RecurrenceRange.EndDate' is_not_null) THEN 'Recurrence.RecurrenceRange.EndDate' >= 'Recurrence.RecurrenceRange.StartDate'"
      },
      "category": "ConditionalAssertion",
      "isEnabled": true
    },
    {
      "ruleId": "8490a6b9-e4a1-4b93-9fa5-cacfbae59cfc",
      "name": "Unique Placeholder IDs",
      "description": "PlaceholderId must be unique within each event's Placeholders array",
      "severity": "Error",
      "scope": "SingleFile",
      "logic": {
        "unique_by_group": {
          "var": "Placeholders.PlaceholderId",
          "groupBy": "EventId",
          "caseSensitive": true
        }
      },
      "metadata": {
        "field": "Placeholders.PlaceholderId",
        "expression": "All values of 'Placeholders.PlaceholderId' must be unique within each 'EventId'"
      },
      "category": "Uniqueness",
      "isEnabled": true
    },
    {
      "ruleId": "aa768904-2cbe-4087-8b27-12b221553f12",
      "name": "Placeholder ID Referenced in Body",
      "description": "Placeholders referenced in event Body must exist in Placeholders array",
      "severity": "Error",
      "scope": "SingleFile",
      "logic": {
        "crossTypeIntegrity": {
          "sourceType": "events",
          "sourceField": "Body",
          "targetType": "events",
          "targetField": "Placeholders.PlaceholderId",
          "sourceExtractPattern": "\\{placeholder:([^}]+)\\}",
          "sameItemLookup": true
        }
      },
      "metadata": {
        "field": "Body",
        "expression": "For each 'Body' (extracted via pattern: \\{placeholder:([^}]+)\\}), a matching value must exist in 'Placeholders.PlaceholderId' within the same item"
      },
      "category": "ReferentialIntegrity",
      "isEnabled": true
    },
    {
      "ruleId": "e238d8c9-d9fe-4b5f-ba00-25574afb48b2",
      "name": "Attachment Files Must Exist",
      "description": "All files referenced in Attachments must exist in the data package",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "fileExistence": {
          "field": "Attachments",
          "caseSensitive": true
        }
      },
      "metadata": {
        "field": "Attachments",
        "expression": "All file paths in 'Attachments' must exist in the ZIP archive (case-sensitive)"
      },
      "category": "FileExistence",
      "isEnabled": true
    },
    {
      "ruleId": "46b6cbc5-2936-4527-b24a-e3931a7b157c",
      "name": "File share integrity check.",
      "description": "Validate if file share links are valid: the FileId must exist in the files.config.json, and the FileOwner and SharedLinkId must match.",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "integrityCheck": {
          "source": {
            "arrayField": "Placeholders.HyperLinkContent",
            "keyField": "FileId"
          },
          "target": {
            "logicType": "or",
            "conditions": [
              {
                "type": "array-exists",
                "targetType": "files",
                "keyField": "FileId",
                "additionalConditions": [
                  {
                    "field": "FileSharedLinks.SharedLinkId",
                    "operator": "contains",
                    "isSourceFieldRef": true,
                    "sourceField": "SharedLinkId",
                    "useCurrentSourceItem": true
                  }
                ]
              }
            ]
          }
        }
      },
      "metadata": {
        "field": "Placeholders.HyperLinkContent.FileId",
        "expression": "Each value from 'Placeholders.HyperLinkContent.FileId' must exists in 'undefined' with matching 'FileId' and FileSharedLinks.SharedLinkIdcontainscurrentItem.SharedLinkId"
      },
      "category": "IntegrityCheck",
      "isEnabled": true
    },
    {
      "ruleId": "ba540ea5-a542-44c2-9cd7-d9431aa7e6c2",
      "name": "Event Sender Must Exist in Users",
      "description": "Event Senders must exist in Users",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "crossTypeIntegrity": {
          "sourceType": "events",
          "sourceField": "Sender",
          "targetType": "users",
          "targetField": "MailNickName"
        }
      },
      "metadata": {
        "field": "Sender",
        "expression": "For each 'events.Sender', a matching 'users.MailNickName' must exist"
      },
      "category": "ReferentialIntegrity",
      "isEnabled": true
    },
    {
      "ruleId": "7e3847ff-a5c5-49d7-b36c-8c4860812cda",
      "name": "Event RequiredAttendees Must Exist in Users",
      "description": "Event RequiredAttendees Must Exist in Users",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "crossTypeIntegrity": {
          "sourceType": "events",
          "sourceField": "RequiredAttendees.Email",
          "targetType": "users",
          "targetField": "MailNickName",
          "sourceExtractPattern": "^([^@]+)$"
        }
      },
      "metadata": {
        "field": "RequiredAttendees.Email",
        "expression": "For each 'events.RequiredAttendees.Email' (extracted via pattern: ^([^@]+)$), a matching 'users.MailNickName' must exist"
      },
      "category": "ReferentialIntegrity",
      "isEnabled": true
    },
    {
      "ruleId": "07b3c5bd-509a-48ee-ac30-58febdfc6359",
      "name": "Event OptionalAttendees must exist in Users",
      "description": "Event OptionalAttendees must exist in Users",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "crossTypeIntegrity": {
          "sourceType": "events",
          "sourceField": "OptionalAttendees.Email",
          "targetType": "users",
          "targetField": "MailNickName",
          "sourceExtractPattern": "^([^@]+)$"
        }
      },
      "metadata": {
        "field": "OptionalAttendees.Email",
        "expression": "For each 'events.OptionalAttendees.Email' (extracted via pattern: ^([^@]+)$), a matching 'users.MailNickName' must exist"
      },
      "category": "ReferentialIntegrity",
      "isEnabled": true
    },
    {
      "ruleId": "f5b8c9d1-4e2a-4c7f-9b3d-8a1e6f7c2b5e",
      "name": "Attachment Files Size Limit",
      "description": "Total size of all attachment files must be less than 3MB per event",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "sizeConstraint": {
          "attachmentField": "Attachments",
          "maxSizeBytes": 3145728,
          "operator": "<"
        }
      },
      "metadata": {
        "field": "Attachments",
        "expression": "Total size of 'Attachments' must be < 3.0MB"
      },
      "category": "SizeConstraint",
      "isEnabled": true
    },
    {
      "ruleId": "8e1d23b5-48db-4ccd-bb91-9d037d7237ca",
      "name": "AllDayEvent TimeZone Check",
      "description": "Make sure: if IsAllDay = true, then both TimeZone field in events.config.json and the corresponding Sender's MailboxSettings.WorkingHours.TimeZone in users.config.json must exist and have the same value",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "customValidator": {
          "validatorId": "all-day-event-timezone-validator-v1"
        }
      },
      "metadata": {
        "field": "",
        "expression": "Execute custom validator 'all-day-event-timezone-validator-v1'"
      },
      "category": "CustomValidator",
      "isEnabled": true
    },
