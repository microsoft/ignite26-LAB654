{"id": "884213411", "displayName": "884213411", "contentDomainCategoryName": "wikis", "isContainer": false, "containerId": null, "UniversalAccessControlBlock": null, "activityList": null, "contentEnrichmentData": null, "associatedItemsMetadata": null, "itemVersion": null, "isAssociatedItem": false, "accessControlList": [{"principal": {"type": "everyone", "value": "EVERYONE", "identitySource": null, "identitySourceEnum": "azureActiveDirectory", "identityType": 3, "identitySourceProperties": null, "metadata": null, "displayName": null}, "ruleNode": null, "accessType": "grant", "transformedIdentity": null}], "properties": {"Id": "884213411", "Title": "Aurora Retail Pricing & Discount Policy", "Url": "https://zava-online.atlassian.net/wiki/spaces/VSALES/pages/884213411/Aurora+Retail+Pricing+%26+Discount+Policy", "Type": "page", "Status": "current", "PageTree": "Zava Sales", "ItemPath": "/Zava Sales", "Labels": ["pricing", "discount-policy", "aurora"], "Likes": 14, "IconUrl": "https://zava-online.atlassian.net/wiki/download/thumbnails/884213307/space-icon.png", "SpaceName": "Zava Sales", "SpaceKey": "VSALES", "SpaceId": "884213307", "SpaceURL": "https://zava-online.atlassian.net/wiki/rest/api/space/VSALES", "SpaceDescription": "Zava retail sales playbooks: pricing and discount policy, competitive battlecards, security and compliance answers for customers, and customer case studies.", "SpaceStatus": "current", "SpaceType": "global", "SpaceLabels": ["sales", "retail", "aurora", "pricing", "enablement"], "CreatedOn": "2026-08-24T14:05:00Z", "CreatedByEmail": "zoe@zava-online.com", "CreatedByName": {"ExternalId": "37c42db9-da87-5d73-b9b9-9644ebcfd474", "Email": "zoe@zava-online.com", "ExternalName": "Zoe Armstrong", "PrincipalType": "user", "id": "zoe@zava-online.com"}, "UpdatedOn": "2026-09-01T13:30:00Z", "UpdatedByEmail": "gerko@zava-online.com", "UpdatedByName": {"ExternalId": "2adfa6ac-0118-514e-aff4-2040d6f8f8d9", "Email": "gerko@zava-online.com", "ExternalName": "Gerko Peterson", "PrincipalType": "user", "id": "gerko@zava-online.com"}, "Authors": [{"ExternalId": "37c42db9-da87-5d73-b9b9-9644ebcfd474", "Email": "zoe@zava-online.com", "ExternalName": "Zoe Armstrong", "PrincipalType": "user", "id": "zoe@zava-online.com"}, {"ExternalId": "2adfa6ac-0118-514e-aff4-2040d6f8f8d9", "Email": "gerko@zava-online.com", "ExternalName": "Gerko Peterson", "PrincipalType": "user", "id": "gerko@zava-online.com"}]}, "content": {"parsedData": "<h1>Aurora Retail Pricing &amp; Discount Policy</h1>\n<p><strong>Status:</strong> Current. Effective for all Aurora retail deals from September 1, 2026. Supersedes the 2025 Aurora retail pricing policy (archived).</p>\n<h2>List price</h2>\n<p>Aurora retail list price is <strong>$3,000 per store</strong>. This includes the in-store Aurora hub kit and 3-year support.</p>\n<h2>Volume discounts and approvals</h2>\n<table>\n<tr><th>Discount off list</th><th>Eligibility</th><th>Approval</th></tr>\n<tr><td>Up to 12%</td><td>250+ stores</td><td>None required</td></tr>\n<tr><td>Over 12% and up to 15%</td><td>250+ stores</td><td>Zoe Armstrong, Director of Retail Sales</td></tr>\n<tr><td>Over 15%</td><td>Any</td><td>VP Sales and Deal Desk</td></tr>\n</table>\n<p>Do not quote a discount that needs approval until it has been approved.</p>\n<h2>Value-add items</h2>\n<p>In-store installation and staff training are normally <strong>$300 per store</strong>. They can be bundled at no charge as value-add on deals of 250+ stores. Value-add items <strong>do not count as discount</strong> toward the tiers above.</p>\n<h2>Worked example</h2>\n<p>400 stores at 12% off: $2,640 per store, about <strong>$1.06M</strong> total, with installation and training bundled as value-add.</p>", "type": "html", "annotation": null, "semanticContent": null}}
{"id": "884213452", "displayName": "884213452", "contentDomainCategoryName": "wikis", "isContainer": false, "containerId": null, "UniversalAccessControlBlock": null, "activityList": null, "contentEnrichmentData": null, "associatedItemsMetadata": null, "itemVersion": null, "isAssociatedItem": false, "accessControlList": [{"principal": {"type": "everyone", "value": "EVERYONE", "identitySource": null, "identitySourceEnum": "azureActiveDirectory", "identityType": 3, "identitySourceProperties": null, "metadata": null, "displayName": null}, "ruleNode": null, "accessType": "grant", "transformedIdentity": null}], "properties": {"Id": "884213452", "Title": "Competitive Battlecard: Boulder Innovations", "Url": "https://zava-online.atlassian.net/wiki/spaces/VSALES/pages/884213452/Competitive+Battlecard+Boulder+Innovations", "Type": "page", "Status": "current", "PageTree": "Zava Sales", "ItemPath": "/Zava Sales", "Labels": ["battlecard", "competitive", "boulder-innovations"], "Likes": 22, "IconUrl": "https://zava-online.atlassian.net/wiki/download/thumbnails/884213307/space-icon.png", "SpaceName": "Zava Sales", "SpaceKey": "VSALES", "SpaceId": "884213307", "SpaceURL": "https://zava-online.atlassian.net/wiki/rest/api/space/VSALES", "SpaceDescription": "Zava retail sales playbooks: pricing and discount policy, competitive battlecards, security and compliance answers for customers, and customer case studies.", "SpaceStatus": "current", "SpaceType": "global", "SpaceLabels": ["sales", "retail", "aurora", "pricing", "enablement"], "CreatedOn": "2026-09-08T15:20:00Z", "CreatedByEmail": "alice@zava-online.com", "CreatedByName": {"ExternalId": "05da8c20-1a47-52ef-af63-0999ec85cbd7", "Email": "alice@zava-online.com", "ExternalName": "Alice Pena", "PrincipalType": "user", "id": "alice@zava-online.com"}, "UpdatedOn": "2026-10-14T20:45:00Z", "UpdatedByEmail": "zoe@zava-online.com", "UpdatedByName": {"ExternalId": "37c42db9-da87-5d73-b9b9-9644ebcfd474", "Email": "zoe@zava-online.com", "ExternalName": "Zoe Armstrong", "PrincipalType": "user", "id": "zoe@zava-online.com"}, "Authors": [{"ExternalId": "05da8c20-1a47-52ef-af63-0999ec85cbd7", "Email": "alice@zava-online.com", "ExternalName": "Alice Pena", "PrincipalType": "user", "id": "alice@zava-online.com"}, {"ExternalId": "37c42db9-da87-5d73-b9b9-9644ebcfd474", "Email": "zoe@zava-online.com", "ExternalName": "Zoe Armstrong", "PrincipalType": "user", "id": "zoe@zava-online.com"}]}, "content": {"parsedData": "<h1>Competitive Battlecard: Boulder Innovations</h1>\n<h2>Positioning</h2>\n<p>Boulder Innovations leads with a low sticker price: about <strong>$2,400 per store</strong>, roughly 20% under Aurora's $3,000 list. The sticker price <strong>excludes</strong> installation and 3-year support, which Aurora includes or bundles.</p>\n<h2>All-in cost per store (3 years)</h2>\n<table>\n<tr><th>Item</th><th>Boulder Innovations</th><th>Zava Aurora (12% volume discount)</th></tr>\n<tr><td>Hub kit</td><td>$2,400</td><td>$2,640 (includes 3-year support)</td></tr>\n<tr><td>In-store installation</td><td>about $350</td><td>Included (value-add)</td></tr>\n<tr><td>3-year support</td><td>about $500</td><td>Included</td></tr>\n<tr><td><strong>All-in per store</strong></td><td><strong>about $3,250</strong></td><td><strong>$2,640</strong></td></tr>\n</table>\n<p>For 400 stores, Aurora at 12% is about $1.06M all-in.</p>\n<h2>How to win</h2>\n<ul>\n<li><strong>Don't lead with discount.</strong> Lead with all-in cost (TCO) and pilot results.</li>\n<li>Bundle installation and staff training as value-add instead of going past the 12% tier.</li>\n<li>Bring finance stakeholders the per-store and total all-in numbers.</li>\n</ul>", "type": "html", "annotation": null, "semanticContent": null}}
{"id": "884213487", "displayName": "884213487", "contentDomainCategoryName": "wikis", "isContainer": false, "containerId": null, "UniversalAccessControlBlock": null, "activityList": null, "contentEnrichmentData": null, "associatedItemsMetadata": null, "itemVersion": null, "isAssociatedItem": false, "accessControlList": [{"principal": {"type": "everyone", "value": "EVERYONE", "identitySource": null, "identitySourceEnum": "azureActiveDirectory", "identityType": 3, "identitySourceProperties": null, "metadata": null, "displayName": null}, "ruleNode": null, "accessType": "grant", "transformedIdentity": null}], "properties": {"Id": "884213487", "Title": "Aurora Security & Compliance FAQ", "Url": "https://zava-online.atlassian.net/wiki/spaces/VSALES/pages/884213487/Aurora+Security+%26+Compliance+FAQ", "Type": "page", "Status": "current", "PageTree": "Zava Sales", "ItemPath": "/Zava Sales", "Labels": ["security", "compliance", "faq"], "Likes": 9, "IconUrl": "https://zava-online.atlassian.net/wiki/download/thumbnails/884213307/space-icon.png", "SpaceName": "Zava Sales", "SpaceKey": "VSALES", "SpaceId": "884213307", "SpaceURL": "https://zava-online.atlassian.net/wiki/rest/api/space/VSALES", "SpaceDescription": "Zava retail sales playbooks: pricing and discount policy, competitive battlecards, security and compliance answers for customers, and customer case studies.", "SpaceStatus": "current", "SpaceType": "global", "SpaceLabels": ["sales", "retail", "aurora", "pricing", "enablement"], "CreatedOn": "2026-07-15T17:00:00Z", "CreatedByEmail": "selma@zava-online.com", "CreatedByName": {"ExternalId": "0a47b09b-1571-56d8-8e71-887d5b48ac99", "Email": "selma@zava-online.com", "ExternalName": "Selma Pakarinen", "PrincipalType": "user", "id": "selma@zava-online.com"}, "UpdatedOn": "2026-10-06T14:10:00Z", "UpdatedByEmail": "selma@zava-online.com", "UpdatedByName": {"ExternalId": "0a47b09b-1571-56d8-8e71-887d5b48ac99", "Email": "selma@zava-online.com", "ExternalName": "Selma Pakarinen", "PrincipalType": "user", "id": "selma@zava-online.com"}, "Authors": [{"ExternalId": "0a47b09b-1571-56d8-8e71-887d5b48ac99", "Email": "selma@zava-online.com", "ExternalName": "Selma Pakarinen", "PrincipalType": "user", "id": "selma@zava-online.com"}]}, "content": {"parsedData": "<h1>Aurora Security &amp; Compliance FAQ</h1>\n<h2>Certifications</h2>\n<p>The Aurora cloud service is <strong>SOC 2 Type II</strong> certified. The current report is available to customers under NDA.</p>\n<h2>Where is data stored?</h2>\n<p>Aurora supports <strong>regional data residency</strong>. US customers' device and store data is stored in US data centers.</p>\n<h2>Does Aurora capture customer data in store?</h2>\n<p>No. Aurora hubs have <strong>no in-store cameras</strong> and do not collect shopper <strong>PII</strong>. Hubs report device status and anonymous demo-station usage only.</p>\n<h2>Security review</h2>\n<p>For rollouts over 100 stores, Zava offers a security review session with the customer's IT security team covering this FAQ, data residency and the rollout plan.</p>", "type": "html", "annotation": null, "semanticContent": null}}
{"id": "884213523", "displayName": "884213523", "contentDomainCategoryName": "wikis", "isContainer": false, "containerId": null, "UniversalAccessControlBlock": null, "activityList": null, "contentEnrichmentData": null, "associatedItemsMetadata": null, "itemVersion": null, "isAssociatedItem": false, "accessControlList": [{"principal": {"type": "everyone", "value": "EVERYONE", "identitySource": null, "identitySourceEnum": "azureActiveDirectory", "identityType": 3, "identitySourceProperties": null, "metadata": null, "displayName": null}, "ruleNode": null, "accessType": "grant", "transformedIdentity": null}], "properties": {"Id": "884213523", "Title": "Case Study: Wide World Importers 320-store rollout", "Url": "https://zava-online.atlassian.net/wiki/spaces/VSALES/pages/884213523/Case+Study+Wide+World+Importers+320-store+rollout", "Type": "page", "Status": "current", "PageTree": "Zava Sales", "ItemPath": "/Zava Sales", "Labels": ["case-study", "aurora"], "Likes": 11, "IconUrl": "https://zava-online.atlassian.net/wiki/download/thumbnails/884213307/space-icon.png", "SpaceName": "Zava Sales", "SpaceKey": "VSALES", "SpaceId": "884213307", "SpaceURL": "https://zava-online.atlassian.net/wiki/rest/api/space/VSALES", "SpaceDescription": "Zava retail sales playbooks: pricing and discount policy, competitive battlecards, security and compliance answers for customers, and customer case studies.", "SpaceStatus": "current", "SpaceType": "global", "SpaceLabels": ["sales", "retail", "aurora", "pricing", "enablement"], "CreatedOn": "2026-09-29T19:40:00Z", "CreatedByEmail": "alice@zava-online.com", "CreatedByName": {"ExternalId": "05da8c20-1a47-52ef-af63-0999ec85cbd7", "Email": "alice@zava-online.com", "ExternalName": "Alice Pena", "PrincipalType": "user", "id": "alice@zava-online.com"}, "UpdatedOn": "2026-09-30T13:15:00Z", "UpdatedByEmail": "alice@zava-online.com", "UpdatedByName": {"ExternalId": "05da8c20-1a47-52ef-af63-0999ec85cbd7", "Email": "alice@zava-online.com", "ExternalName": "Alice Pena", "PrincipalType": "user", "id": "alice@zava-online.com"}, "Authors": [{"ExternalId": "05da8c20-1a47-52ef-af63-0999ec85cbd7", "Email": "alice@zava-online.com", "ExternalName": "Alice Pena", "PrincipalType": "user", "id": "alice@zava-online.com"}]}, "content": {"parsedData": "<h1>Case Study: Wide World Importers 320-store rollout</h1>\n<h2>Summary</h2>\n<p>Wide World Importers rolled Aurora out to 320 stores after a 40-store pilot. Boulder Innovations was also shortlisted.</p>\n<h2>Timeline</h2>\n<ul>\n<li>Pilot: 40 stores, 6 weeks</li>\n<li>Security review with WWI IT: 2 weeks before signature</li>\n<li>Rollout: 320 stores in 10 weeks, in three regional waves</li>\n</ul>\n<h2>Outcome</h2>\n<p>Zava won on all-in cost: a 12% volume discount with installation and staff training bundled as value-add, and no discount above 12%. WWI reported higher smart-home bundle attach rates in rollout stores in the first quarter after launch.</p>", "type": "html", "annotation": null, "semanticContent": null}}
