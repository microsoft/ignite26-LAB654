alType": "user", "id": "gerko@zava-online.com"}, "Authors": [{"ExternalId": "2adfa6ac-0118-514e-aff4-2040d6f8f8d9", "Email": "gerko@zava-online.com", "ExternalName": "Gerko Peterson", "PrincipalType": "user", "id": "gerko@zava-online.com"}]}, "content": {"parsedData": "<h1>Aurora Retail Pricing Policy (2025)</h1>\n<p><strong>ARCHIVED.</strong> Superseded by the current Aurora Retail Pricing &amp; Discount Policy. Do not use for new deals.</p>\n<p>List price $3,200 per store. Volume discounts up to 18% at 200+ stores with regional sales manager approval.</p>", "type": "html", "annotation": null, "semanticContent": null}}
