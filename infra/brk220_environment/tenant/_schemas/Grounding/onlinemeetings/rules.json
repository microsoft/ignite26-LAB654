{
  "typeName": "onlinemeetings",
  "rules": [
    {
      "ruleId": "09a7c12b-b1cf-4414-b682-fa83bfa8b486",
      "name": "Unique OnlineMeetingId",
      "description": "OnlineMeetingId must be unique. ",
      "severity": "Error",
      "scope": "SingleFile",
      "logic": {
        "unique": {
          "var": "OnlineMeetingId",
          "caseSensitive": true
        }
      },
      "metadata": {
        "field": "OnlineMeetingId",
        "expression": "All values of 'OnlineMeetingId' must be unique"
      },
      "category": "Uniqueness",
      "isEnabled": true
    },
    {
      "ruleId": "0ec5242c-a36d-498a-830d-7108c4c2cbc3",
      "name": "Online meeting StartDateTime should earlier than EndDateTime",
      "description": "Online meeting StartDateTime should earlier than EndDateTime",
      "severity": "Error",
      "scope": "SingleFile",
      "logic": {
        "conditionalAssertion": {
          "if": {
            "and": [
              {
                "field": "StartDateTime",
                "operator": "is_not_null",
                "valueType": "string"
              },
              {
                "field": "EndDateTime",
                "operator": "is_not_null",
                "valueType": "string"
              }
            ]
          },
          "then": {
            "field": "EndDateTime",
            "operator": ">",
            "valueType": "datetime",
            "compareField": "StartDateTime"
          }
        }
      },
      "metadata": {
        "field": "",
        "expression": "IF ('StartDateTime' is_not_null) AND ('EndDateTime' is_not_null) THEN 'EndDateTime' > 'StartDateTime'"
      },
      "category": "ConditionalAssertion",
      "isEnabled": true
    },
    {
      "ruleId": "ba3b47f8-6778-4b7e-ae9b-10b90b43d9fb",
      "name": "Owner must be Event Sender",
      "description": "Owner must be Event Sender",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "integrityCheck": {
          "source": {
            "field": "EventId"
          },
          "target": {
            "logicType": "or",
            "conditions": [
              {
                "type": "array-exists",
                "targetType": "events",
                "keyField": "EventId",
                "additionalConditions": [
                  {
                    "field": "Sender",
                    "operator": "==",
                    "isSourceFieldRef": true,
                    "sourceField": "Owner"
                  }
                ]
              }
            ]
          }
        }
      },
      "metadata": {
        "field": "EventId",
        "expression": "Each value from 'EventId' must exists in '' with matching 'EventId' and Sender==source.Owner"
      },
      "category": "IntegrityCheck",
      "isEnabled": true
    },
    {
      "ruleId": "a1f22f68-2f38-47fc-9046-da40bd6719bd",
      "name": "Internal Participants must exist in Users",
      "description": "Internal Participants must exist in Users",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "crossTypeIntegrity": {
          "sourceType": "onlinemeetings",
          "sourceField": "Participants",
          "targetType": "users",
          "targetField": "MailNickName"
        }
      },
      "metadata": {
        "field": "Participants",
        "expression": "For each 'onlinemeetings.Participants', a matching 'users.MailNickName' must exist"
      },
      "category": "ReferentialIntegrity",
      "isEnabled": true
    },
    {
      "ruleId": "cea0cdda-5861-416e-9195-54e02335a984",
      "name": "Transcript Files must exist",
      "description": "All transcript files must exist in the data package",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "fileExistence": {
          "field": "Transcripts.TranscriptFile",
          "caseSensitive": false
        }
      },
      "metadata": {
        "field": "Transcripts.TranscriptFile",
        "expression": "All file paths in 'Transcripts.TranscriptFile' must exist in the ZIP archive (case-insensitive)"
      },
      "category": "FileExistence",
      "isEnabled": true
    },
    {
      "ruleId": "16b82cde-995c-4210-876c-3a0bd46f03d6",
      "name": "EventId must exist in Events",
      "description": "EventId must exist in Events",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "crossTypeIntegrity": {
          "sourceType": "onlinemeetings",
          "sourceField": "EventId",
          "targetType": "events",
          "targetField": "EventId"
        }
      },
      "metadata": {
        "field": "EventId",
        "expression": "For each 'onlinemeetings.EventId', a matching 'events.EventId' must exist"
      },
      "category": "ReferentialIntegrity",
      "isEnabled": true
    },
    {
      "ruleId": "f847d6e7-e12c-4de8-a04e-4097eaa7ed8c",
      "name": "ChatId must exist in Chats",
      "description": "ChatId must exist in Chats",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "crossTypeIntegrity": {
          "sourceType": "onlinemeetings",
