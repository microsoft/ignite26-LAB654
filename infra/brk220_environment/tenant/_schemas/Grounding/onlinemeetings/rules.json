      "category": "ReferentialIntegrity",
      "isEnabled": true
    },
    {
      "ruleId": "3f3f6b13-1c69-4414-8a82-bdf7efb95485",
      "name": "Only Event Meetings Can Be Ingested",
      "description": "Only meetings represented as calendar events are eligible for ingestion. Non‑event meetings are ignored.",
      "severity": "Info",
      "scope": "SingleFile",
      "logic": {
        "conditionalAssertion": {
          "if": {
            "field": "OnlineMeetingId",
            "operator": "is_not_null",
            "valueType": "string",
            "value": ""
          },
          "then": {
            "field": "OnlineMeetingType",
            "operator": "==",
            "valueType": "string",
            "value": "Event"
          }
        }
      },
      "metadata": {
        "field": "",
        "expression": "IF 'OnlineMeetingId' is_not_null THEN 'OnlineMeetingType' == Event"
      },
      "category": "ConditionalAssertion",
      "isEnabled": true
    },
    {
      "ruleId": "93b3dc85-18a6-4c9b-a704-d2584c2bdc6b",
      "name": "Referenced Event Must Be an Online Meeting",
      "description": "Referenced Event Must Be an Online Meeting",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "integrityCheck": {
          "source": {
            "field": "EventId"
          },
          "target": {
            "logicType": "and",
            "conditions": [
              {
                "type": "array-exists",
                "targetType": "events",
                "keyField": "EventId",
                "additionalConditions": [
                  {
                    "field": "IsOnlineMeeting",
                    "operator": "==",
                    "value": "true"
                  }
                ]
              }
            ]
          }
        }
      },
      "metadata": {
        "field": "EventId",
        "expression": "Each value from 'EventId' must exists in '' with matching 'EventId' and IsOnlineMeeting==true"
      },
      "category": "IntegrityCheck",
      "isEnabled": true
    },
