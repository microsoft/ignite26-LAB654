      "isEnabled": true
    },
    {
      "ruleId": "fd42a2e2-db6c-4ea0-bd1e-6e2f7cf5798f",
      "name": "Transcript custom validation. ",
      "description": "1. Validate the speakers in script file exist in event group. \n2. Validate if current script file has a valid format. ",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "customValidator": {
          "validatorId": "transcript-validator-v1"
        }
      },
      "metadata": {
        "field": "",
