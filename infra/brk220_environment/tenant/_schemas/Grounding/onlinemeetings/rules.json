      },
      "category": "CustomValidator",
      "isEnabled": true
    },
    {
      "ruleId": "fc0fd770-784f-4bf7-812b-8c74592e0440",
      "name": "ChannelId must exist in Channels",
      "description": "ChannelId must exist in Channels",
      "severity": "Error",
      "scope": "CrossFile",
      "logic": {
        "crossTypeIntegrity": {
          "sourceType": "onlinemeetings",
          "sourceField": "ChannelId",
          "targetType": "channels",
          "targetField": "ChannelId"
        }
      },
      "metadata": {
        "field": "ChannelId",
        "expression": "For each 'onlinemeetings.ChannelId', a matching 'channels.ChannelId' must exist"
